<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-API-26 launcher icon. `minSdk` is 24, so two API levels have no
    adaptive icons and fall back to this; API 26+ resolves
    `mipmap-anydpi-v26/ic_launcher.xml` instead.

    Same mark, composed into one drawable, and scaled up: the adaptive
    foreground is drawn small because a launcher mask crops it, but nothing
    crops a legacy icon, so at the same scale it would sit in a wide margin
    and look shrunken next to its neighbours.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#080B08" />

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.45"
        android:scaleY="1.45">
        <path
            android:pathData="M 54 44 C 54 36 43 32.5 36 36 C 29.5 39.5 29.5 48 37.5 52 C 46 56 54 59.5 53 66.5 C 52 73.5 40.5 75.5 33 71"
            android:strokeColor="#7DFFA4"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M 41.5 27 L 41.5 80"
            android:strokeColor="#7DFFA4"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 64.5 71.5 L 78.5 71.5"
            android:strokeColor="#7DFFA4"
            android:strokeWidth="7"
            android:strokeLineCap="round" />
    </group>
</vector>
