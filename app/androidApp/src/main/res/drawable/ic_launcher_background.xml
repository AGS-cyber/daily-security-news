<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat background, the `bg` colour from the site's palette.

    Deliberately no scanlines. The overlay is 1px every 3px, which reads as
    texture across a page but collapses into moire and mud once a launcher
    scales it to 48dp. The scanlines belong in the app's own UI, where they
    are drawn at their real size, and not in a mark that must survive being
    shrunk.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#080B08" />
</vector>
